// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model dictionary {
  id     Int    @id @default(autoincrement())
  userId String @map("user_id")
  title  String
  icon   String

  @@map("dictionaries")
}
