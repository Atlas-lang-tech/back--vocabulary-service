# Postgres connection string used by Prisma (PrismaService reads process.env.DATABASE_URL).
DATABASE_URL="postgresql://postgres:admin@localhost:5432/vocabulary"

# Redis (validated at boot by src/common/env.validation.ts).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# App port (optional, defaults to 3000).
# PORT=3000
